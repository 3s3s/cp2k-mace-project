<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CP2K + MACE — управление main.py</title>
  <link rel="stylesheet"
        href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-beta.2/css/bootstrap.min.css"
        integrity="sha384-PsH8R72JQ3SOdhVi3uxftmaW6Vc51MKb0q5P2rRUpPvrszuE4W1povHYgTpBfshb"
        crossorigin="anonymous">
  <style>
    body { padding-bottom: 40px; }
    .param-row { margin-bottom: .75rem; }
    .param-help { font-size: .85rem; color: #6c757d; }
    .param-name { font-weight: 600; font-family: monospace; }
    #log {
      background: #111; color: #ddd;
      font-family: monospace; font-size: 12px;
      height: 420px; overflow-y: auto;
      padding: 8px; white-space: pre-wrap; word-break: break-word;
      border-radius: 4px;
    }
    .badge-running { background: #28a745; }
    .badge-stopped { background: #6c757d; }
    .badge-failed  { background: #dc3545; }
    .badge-unknown { background: #ffc107; color: #212529; }
    .sticky-actions {
      position: sticky; top: 0; z-index: 10;
      background: #fff; padding: .6rem 0;
      border-bottom: 1px solid #eee; margin-bottom: 1rem;
    }
    .cluster-box {
      background: #f8f9fa; border: 1px solid #e9ecef;
      border-radius: 6px; padding: 12px; margin-bottom: 1.25rem;
    }
  </style>
</head>
<body>
<div class="container pt-3">

  <h3 class="mb-3">CP2K + MACE — панель управления main.py</h3>

  <!-- Статус + действия -->
  <div class="sticky-actions">
    <div class="d-flex align-items-center flex-wrap mb-2">
      <span class="mr-2">Статус main.py:</span>
      <span id="status-badge" class="badge badge-unknown mr-3">неизвестно</span>
      <span class="mr-3">PID: <code id="pid-label">—</code></span>
      <span class="mr-3">Лог: <code id="log-size">0 B</code></span>

      <div class="ml-auto">
        <button id="btn-run" class="btn btn-success btn-sm mr-1">Запустить main.py</button>
        <button id="btn-stop" class="btn btn-danger btn-sm mr-1">Прервать</button>
        <a id="btn-download" class="btn btn-primary btn-sm" href="/download">Скачать artifacts.zip</a>
      </div>
    </div>

    <div class="form-inline">
      <label class="mr-2" for="master-port">Порт FastAPI очереди в main.py:</label>
      <input id="master-port" type="number" class="form-control form-control-sm mr-3" style="width: 100px;" value="8000" min="1" max="65535" />
      <small class="text-muted">
        Воркеры подключаются к этому порту (<code>/register-worker</code>, <code>/get-task</code>, <code>/submit-result</code>).
      </small>
    </div>
  </div>

  <!-- Состояние очереди и воркеров -->
  <div class="cluster-box">
    <div class="d-flex align-items-center mb-2">
      <h5 class="mb-0 mr-3">Очередь и воркеры</h5>
      <span id="queue-conn-badge" class="badge badge-secondary">очередь недоступна</span>
    </div>
    <div class="row text-center mb-2">
      <div class="col-4">
        <div class="text-muted small">В очереди</div>
        <strong id="q-pending" class="h5">—</strong>
      </div>
      <div class="col-4">
        <div class="text-muted small">В работе у воркеров</div>
        <strong id="q-active" class="h5">—</strong>
      </div>
      <div class="col-4">
        <div class="text-muted small">Завершено</div>
        <strong id="q-completed" class="h5">—</strong>
      </div>
    </div>
    <div class="small">
      <div><strong>Зарегистрированные воркеры:</strong> <code id="q-workers">—</code></div>
      <div class="mt-1"><strong>Логи воркеров:</strong> <span id="worker-logs-list" class="text-muted">—</span></div>
    </div>
  </div>

  <!-- Конфиг -->
  <h5 class="mb-3">config.json</h5>
  <div id="config-alert" class="alert alert-info d-none"></div>
  <div id="config-form"></div>

  <div class="mt-3 mb-4">
    <button id="btn-save" class="btn btn-primary mr-2">Сохранить config.json</button>
    <button id="btn-reload" class="btn btn-info text-white">Перечитать config.json</button>
  </div>

  <!-- Лог -->
  <div class="d-flex align-items-center mb-2">
    <h5 class="mb-0">Лог main.py</h5>
    <div class="ml-auto form-check">
      <input class="form-check-input" type="checkbox" id="autoscroll" checked>
      <label class="form-check-label" for="autoscroll">автоскролл</label>
    </div>
  </div>
  <div id="log"></div>

</div>

<script>
async function jget(url) {
  const r = await fetch(url, { headers: { 'Accept': 'application/json' } });
  if (!r.ok) throw new Error(await r.text());
  return r.json();
}
async function jpost(url, body) {
  const r = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body || {}),
  });
  const data = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(data.error || ('HTTP ' + r.status));
  return data;
}
function fmtBytes(n) {
  if (!n) return '0 B';
  if (n < 1024) return n + ' B';
  if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
  return (n / (1024 * 1024)).toFixed(2) + ' MB';
}
function escapeHtml(s) {
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function getMasterPort() {
  const p = parseInt(document.getElementById('master-port').value, 10);
  return Number.isFinite(p) && p > 0 ? p : 8000;
}

// ======================== Config UI ========================
function makeInput(key, value) {
  let el;
  if (typeof value === 'boolean') {
    el = document.createElement('select');
    el.className = 'form-control form-control-sm';
    el.dataset.type = 'boolean';
    el.innerHTML = '<option value="true">true</option><option value="false">false</option>';
    el.value = String(value);
  } else if (typeof value === 'number') {
    el = document.createElement('input');
    el.type = 'number';
    el.step = 'any';
    el.className = 'form-control form-control-sm';
    el.dataset.type = 'number';
    el.value = value;
  } else if (value === null) {
    el = document.createElement('input');
    el.type = 'text';
    el.className = 'form-control form-control-sm';
    el.dataset.type = 'null';
    el.placeholder = 'null';
    el.value = '';
  } else if (typeof value === 'string') {
    el = document.createElement('input');
    el.type = 'text';
    el.className = 'form-control form-control-sm';
    el.dataset.type = 'string';
    el.value = value;
  } else {
    el = document.createElement('textarea');
    el.className = 'form-control form-control-sm';
    el.rows = 3;
    el.dataset.type = 'json';
    el.value = JSON.stringify(value, null, 2);
  }
  el.dataset.key = key;
  return el;
}

function renderConfig(cfg) {
  const form = document.getElementById('config-form');
  form.innerHTML = '';
  for (const key of Object.keys(cfg)) {
    const item = cfg[key];
    const isHelpStyle = item && typeof item === 'object' && 'value' in item && 'help' in item;
    const value = isHelpStyle ? item.value : item;
    const help = isHelpStyle ? item.help : '';

    const row = document.createElement('div');
    row.className = 'param-row form-group';

    const label = document.createElement('label');
    label.className = 'mb-1';
    label.innerHTML = '<span class="param-name">' + key + '</span>' +
                      (help ? ' <span class="param-help">— ' + escapeHtml(help) + '</span>' : '');
    row.appendChild(label);
    row.appendChild(makeInput(key, value));
    form.appendChild(row);
  }
}

function collectConfig() {
  const inputs = document.querySelectorAll('#config-form [data-key]');
  const out = {};
  for (const el of inputs) {
    const key = el.dataset.key;
    const type = el.dataset.type;
    let v;
    if (type === 'boolean') v = (el.value === 'true');
    else if (type === 'number') v = (el.value === '' ? 0 : Number(el.value));
    else if (type === 'null') v = (el.value.trim() === '' ? null : el.value.trim());
    else if (type === 'string') v = el.value;
    else {
      try { v = JSON.parse(el.value); }
      catch (e) { throw new Error('Невалидный JSON в поле ' + key + ': ' + e.message); }
    }
    out[key] = v;
  }
  return out;
}

// ======================== API actions ========================
async function loadConfig() {
  const alert = document.getElementById('config-alert');
  alert.classList.add('d-none');
  try {
    const data = await jget('/api/config');
    renderConfig(data.config || {});
  } catch (e) {
    alert.className = 'alert alert-danger';
    alert.textContent = 'Не удалось прочитать config: ' + e.message;
    alert.classList.remove('d-none');
  }
}

async function saveConfig() {
  const alert = document.getElementById('config-alert');
  try {
    const values = collectConfig();
    const body = { config: {} };
    for (const k of Object.keys(values)) body.config[k] = { value: values[k] };
    await jpost('/api/config', body);
    alert.className = 'alert alert-success';
    alert.textContent = 'config.json сохранён';
    alert.classList.remove('d-none');
    await loadConfig();
  } catch (e) {
    alert.className = 'alert alert-danger';
    alert.textContent = 'Ошибка сохранения: ' + e.message;
    alert.classList.remove('d-none');
  }
}

async function runMain() {
  const alert = document.getElementById('config-alert');
  try {
    const port = getMasterPort();
    await jpost('/api/run', { port });
    alert.className = 'alert alert-success';
    alert.textContent = 'main.py запущен на порту ' + port;
    alert.classList.remove('d-none');
  } catch (e) {
    alert.className = 'alert alert-danger';
    alert.textContent = 'Не удалось запустить main.py: ' + e.message;
    alert.classList.remove('d-none');
  }
}

async function stopMain() {
  const alert = document.getElementById('config-alert');
  try {
    await jpost('/api/stop', {});
    alert.className = 'alert alert-warning';
    alert.textContent = 'main.py: отправлен сигнал остановки';
    alert.classList.remove('d-none');
  } catch (e) {
    alert.className = 'alert alert-danger';
    alert.textContent = 'Не удалось остановить main.py: ' + e.message;
    alert.classList.remove('d-none');
  }
}

// ======================== Polling ========================
let logOffset = 0;

function appendLog(chunk) {
  if (!chunk) return;
  const el = document.getElementById('log');
  el.textContent += chunk;
  if (document.getElementById('autoscroll').checked) {
    el.scrollTop = el.scrollHeight;
  }
}

async function pollLog() {
  try {
    const data = await jget('/api/log?offset=' + logOffset);
    if (data.offset < logOffset) {
      document.getElementById('log').textContent = '';
      logOffset = 0;
    }
    appendLog(data.chunk || '');
    logOffset = data.offset;
  } catch (e) {}
}

async function pollStatus() {
  try {
    const data = await jget('/api/status');
    const badge = document.getElementById('status-badge');
    let state = 'unknown';
    if (data.alive) state = 'running';
    else if (data.status && data.status.state) state = data.status.state;

    badge.className = 'badge mr-3 badge-' + (state === 'running' ? 'running'
      : state === 'failed' ? 'failed'
      : state === 'finished' ? 'stopped'
      : state === 'stopped' ? 'stopped'
      : 'unknown');
    badge.textContent = state;

    document.getElementById('pid-label').textContent = data.pid || '—';
    document.getElementById('log-size').textContent = fmtBytes(data.log_size || 0);
  } catch (e) {}
}

async function pollCluster() {
  try {
    const port = getMasterPort();
    const data = await jget('/api/cluster?port=' + port);
    const connBadge = document.getElementById('queue-conn-badge');

    if (data.master_reachable && data.queue) {
      connBadge.className = 'badge badge-success';
      connBadge.textContent = 'очередь онлайн (:' + port + ')';
      document.getElementById('q-pending').textContent = data.queue.pending ?? 0;
      document.getElementById('q-active').textContent = data.queue.active ?? 0;
      document.getElementById('q-completed').textContent = data.queue.completed ?? 0;
      const workers = Array.isArray(data.queue.workers) && data.queue.workers.length
        ? data.queue.workers.join(', ')
        : 'нет подключенных';
      document.getElementById('q-workers').textContent = workers;
    } else {
      connBadge.className = 'badge badge-secondary';
      connBadge.textContent = 'очередь недоступна';
      document.getElementById('q-pending').textContent = '—';
      document.getElementById('q-active').textContent = '—';
      document.getElementById('q-completed').textContent = '—';
      document.getElementById('q-workers').textContent = '—';
    }

    const logsEl = document.getElementById('worker-logs-list');
    if (Array.isArray(data.worker_logs) && data.worker_logs.length) {
      logsEl.textContent = data.worker_logs
        .map((w) => w.file + ' (' + fmtBytes(w.size) + ')')
        .join(', ');
    } else {
      logsEl.textContent = 'пока нет';
    }
  } catch (e) {}
}

// ======================== init ========================
document.getElementById('btn-run').addEventListener('click', runMain);
document.getElementById('btn-stop').addEventListener('click', stopMain);
document.getElementById('btn-save').addEventListener('click', saveConfig);
document.getElementById('btn-reload').addEventListener('click', function(e) {
  e.preventDefault();
  loadConfig();
});

(async function init() {
  try { await loadConfig(); } catch(e) { console.error(e); }
  try { await pollLog(); } catch(e) { console.error(e); }
  try { await pollStatus(); } catch(e) { console.error(e); }
  try { await pollCluster(); } catch(e) { console.error(e); }

  setInterval(() => {
    pollLog().catch(console.error);
    pollStatus().catch(console.error);
    pollCluster().catch(console.error);
  }, 1000);
})();
</script>
</body>
</html>